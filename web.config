<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Pass PHP output straight through (don't replace with IIS canned 500 page) -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    <!-- Disable dynamic compression while debugging PHP responses -->
    <urlCompression doDynamicCompression="false" doStaticCompression="false" />

    <handlers>
      <add name="PHP" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\php\php-cgi.exe" resourceType="File" />
    </handlers>

    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- Allow larger uploads (bytes). 262144000 = 250 MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="262144000" />
      </requestFiltering>
    </security>

    <!-- Ensure static files have correct MIME types -->
    <staticContent>
      <!-- remove first only if they already exist to avoid duplicates -->
      <remove fileExtension=".mp4" />
      <remove fileExtension=".m4v" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".vtt" />

      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <mimeMap fileExtension=".m4v" mimeType="video/mp4" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".vtt" mimeType="text/vtt" />
    </staticContent>
  </system.webServer>

  <system.web>
    <!-- ASP.NET setting also helps IIS not mask errors -->
    <customErrors mode="Off" />
  </system.web>
</configuration>